# Clés des sources publiques (ne jamais committer le vrai fichier .env).
AVIATIONSTACK_KEY=

# OpenSky Network (backfill chantier 2).
# Depuis mars 2026 l'API n'accepte plus le basic auth : il faut un client OAuth2
# (compte OpenSky > Account > API client). Coller le client_id / client_secret ici.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Conservés pour compatibilité avec le cahier des charges. Si CLIENT_ID/SECRET
# sont vides, le backfill tente USER comme client_id et PASS comme client_secret.
OPENSKY_USER=
OPENSKY_PASS=
# Délai entre requêtes OpenSky, en secondes (quotas /flights).
OPENSKY_REQUEST_DELAY_S=10

# Connexion Postgres (Compose définit déjà cette valeur pour le service app).
DATABASE_URL=postgresql://corridor:corridor@localhost:5432/corridor

# Jour civil du corridor : les départs sont le soir à Brazzaville / Pointe-Noire.
TIMEZONE=Africa/Brazzaville

# Quota AviationStack : 100 requêtes/mois, 4 par jour de vol maximum.
AVIATIONSTACK_MAX_REQ_PER_DAY=4
# 1 = collecteurs sur échantillons figés (tests).
COLLECTORS_USE_SAMPLE=
