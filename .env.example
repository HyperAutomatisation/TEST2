# Clés des sources publiques (ne jamais committer le vrai fichier .env).
AVIATIONSTACK_KEY=
OPENSKY_USER=
OPENSKY_PASS=

# Connexion Postgres (Compose définit déjà cette valeur pour le service app).
DATABASE_URL=postgresql://corridor:corridor@localhost:5432/corridor

# Jour civil du corridor : les départs sont le soir à Brazzaville / Pointe-Noire.
TIMEZONE=Africa/Brazzaville
